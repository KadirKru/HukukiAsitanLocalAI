# =============================================
# Hukuki Danışman AI - Konfigürasyon Şablonu
# Bu dosyayı .env olarak kopyalayın ve doldurun
# =============================================

# LLM Sağlayıcısı: "openai" veya "ollama"
LLM_PROVIDER=openai

# OpenAI (LLM_PROVIDER=openai ise)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama (LLM_PROVIDER=ollama ise, yerel kurulum)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding Modeli (Türkçe destekli)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB Yolu
CHROMA_DB_PATH=./data/chroma_db

# Koleksiyon Adları
KANUNLAR_COLLECTION=kanunlar
YARGITAY_COLLECTION=yargitay_kararlari

# API Ayarları
API_HOST=0.0.0.0
API_PORT=8000

# RAG Ayarları
TOP_K_RESULTS=5
MAX_CONTEXT_LENGTH=4000
CHUNK_SIZE=512
CHUNK_OVERLAP=50
