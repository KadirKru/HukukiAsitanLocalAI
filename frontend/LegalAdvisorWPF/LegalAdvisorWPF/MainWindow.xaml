<Window x:Class="LegalAdvisorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LegalAdvisorWPF.ViewModels"
        xmlns:conv="clr-namespace:LegalAdvisorWPF.Converters"
        Title="Hukuki Danışman AI — RAG Sistemi"
        Height="820" Width="1380"
        MinHeight="600" MinWidth="960"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:SourceTypeToBrushConverter       x:Key="SrcBrush"/>
        <conv:StringToVisibilityConverter      x:Key="StrVis"/>
        <conv:ScoreToPercentConverter          x:Key="ScorePct"/>
        <BooleanToVisibilityConverter          x:Key="B2V"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hukuki Danışman AI"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="RAG Tabanlı Yapay Zeka Hukuk Sistemi"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ApiStatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="Yenile" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Cursor="Hand" FontSize="12"
                            Command="{Binding CheckApiCommand}"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tema Butonu -->
                    <Button x:Name="ThemeBtn" Content="Tema" Margin="8,0,0,0"
                            Background="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            Foreground="White"
                            Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                            Padding="12,3"
                            VerticalAlignment="Center"
                            Click="ThemeBtn_Click"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="295" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Ayırıcı -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

            <!-- Sağ Ayırıcı -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

            <!-- SOL PANEL -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Soru Kartı -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="HUKUKİ SORU"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="SORUNUZU YAZIN" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="185"
                                 Margin="0,0,0,12">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Modifiers="Control"
                                            Command="{Binding SendQueryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Text="İSLEM TÜRÜ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableQueryTypes}"
                                  SelectedItem="{Binding SelectedQueryType}"
                                  Margin="0,0,0,12" Height="34" FontSize="12"
                                  Padding="8,0" VerticalContentAlignment="Center"
                                  Background="#151525" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

                        <TextBlock Text="YAPAY ZEKA MODELİ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  Margin="0,0,0,12" Height="34" FontSize="12"
                                  Padding="8,0" VerticalContentAlignment="Center"
                                  Background="#151525" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

                        <Button Content="Soru Sor  (Ctrl+Enter)"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SendQueryCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"/>

                        <!-- Yükleniyor -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="İşleniyor..."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- PDF Kartı -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="PDF DAVA DOSYASI"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,10"/>

                        <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,8"
                                Background="#0A0A14"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <TextBlock Text="{Binding UploadedFileName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Dosya Sec"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SelectPdfCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="2" Content="Analiz Et"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding UploadAndAnalyzePdfCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ORTA: AI Cevabı -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cevap Başlık Barı -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}"
                        Padding="14,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="AI CEVABI"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding ConfidenceBadge}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Visibility="{Binding ConfidenceBadge, Converter={StaticResource StrVis}}"/>
                            <Button Content="PDF İndir"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ExportToPdfCommand}"
                                    Padding="10,5" FontSize="11" Margin="0,0,8,0"/>
                            <Button Content="Temizle"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearAllCommand}"
                                    Padding="10,5" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cevap İçeriği -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <TextBlock Visibility="{Binding IsAnswerEmpty, Converter={StaticResource BoolVis}}"
                                   Text="Hukuki sorunuzu sol panele yazın ve Soru Sor butonuna tıklayın.&#x0A;&#x0A;Sistem ilgili kanun maddelerini ve Yargıtay kararlarını bularak kaynak göstererek cevap üretecektir."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13" TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="40"/>

                        <ScrollViewer Visibility="{Binding Answer, Converter={StaticResource StrVis}}"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding Answer, Mode=OneWay}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     FontSize="13" TextWrapping="Wrap"
                                     AcceptsReturn="True"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Ayrac -->
                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Visibility="{Binding PdfAnalysis, Converter={StaticResource StrVis}}"
                              Background="Transparent"
                              Margin="0,4"
                              Cursor="SizeNS"/>

                <!-- PDF Analiz Sonucu -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                        Padding="14" Margin="0" MinHeight="100"
                        Visibility="{Binding PdfAnalysis, Converter={StaticResource StrVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="PDF ANALİz SONUCU"
                                       Style="{StaticResource SectionLabelStyle}"
                                       VerticalAlignment="Center"/>
                            <Button Content="Kopyala" 
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,3" FontSize="10"
                                    Command="{Binding CopyPdfAnalysisCommand}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding PdfAnalysis, Mode=OneWay}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12" TextWrapping="Wrap"
                                     IsReadOnly="True" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- SAG PANEL: Kaynaklar -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="KAYNAKLAR"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Sources.Count}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Visibility="{Binding IsSourcesEmpty, Converter={StaticResource BoolVis}}"
                                       Text="Soru sorduktan sonra ilgili kanun maddeleri ve Yargıtay kararları burada görüntülenecektir."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="6,16"/>

                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,7"
                                                CornerRadius="9" Padding="10"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                Background="#0C0C1E">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Background="{Binding SourceType, Converter={StaticResource SrcBrush}}"
                                                            CornerRadius="4" Padding="4,2"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="White">
                                                            <Run Text="{Binding SourceIcon, Mode=OneWay}"/>
                                                            <Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               Text="{Binding RelevanceScore, Converter={StaticResource ScorePct}}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,3"/>

                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Margin="0,0,0,3"
                                                           Visibility="{Binding ArticleNumber, Converter={StaticResource StrVis}}">
                                                    <Run Text="Madde "/>
                                                    <Run Text="{Binding ArticleNumber, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="72"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ProcessingInfo}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding ProcessingInfo, Converter={StaticResource StrVis}}"/>
            </Grid>
        </Border>

        <!-- TEMA PANELİ (Overlay) -->
        <Border x:Name="ThemePanel" Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,54,0,0"
                Width="280"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,1"
                Visibility="Collapsed">
            <StackPanel Margin="16">
                <TextBlock Text="RENK TEMASI" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12"/>

                <!-- Hazır Temalar -->
                <TextBlock Text="Hazir Temalar" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="ThemePresetPanel" Margin="0,0,0,12"/>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,4,0,12"/>

                <!-- Özel Renkler -->
                <TextBlock Text="Ozel Renkler" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Arka Plan" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" x:Name="BgColorSwatch" Width="28" Height="28"
                            CornerRadius="6" Cursor="Hand"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MouseLeftButtonUp="BgColorSwatch_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pencere Rengi" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" x:Name="SurfaceColorSwatch" Width="28" Height="28"
                            CornerRadius="6" Cursor="Hand"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MouseLeftButtonUp="SurfaceColorSwatch_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Vurgu Rengi" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" x:Name="AccentColorSwatch" Width="28" Height="28"
                            CornerRadius="6" Cursor="Hand"
                            Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MouseLeftButtonUp="AccentColorSwatch_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Buton Rengi" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" x:Name="ButtonBgColorSwatch" Width="28" Height="28"
                            CornerRadius="6" Cursor="Hand"
                            Background="{DynamicResource ButtonBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MouseLeftButtonUp="ButtonBgColorSwatch_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Yazi Rengi" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" x:Name="TextColorSwatch" Width="28" Height="28"
                            CornerRadius="6" Cursor="Hand"
                            Background="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MouseLeftButtonUp="TextColorSwatch_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Buton Yazi Rengi" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" x:Name="ButtonTextColorSwatch" Width="28" Height="28"
                            CornerRadius="6" Cursor="Hand"
                            Background="{DynamicResource ButtonTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MouseLeftButtonUp="ButtonTextColorSwatch_Click"/>
                </Grid>

                <Button Content="Paneli Kapat" Margin="0,8,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="ThemeBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
